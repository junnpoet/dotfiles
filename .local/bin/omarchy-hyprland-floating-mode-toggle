#!/usr/bin/env bash
# omarchy:summary=Toggle default floating mode for new windows

set -euo pipefail

TOGGLE_DIR="$HOME/.local/state/omarchy/toggles/hypr"
TOGGLE_FILE="$TOGGLE_DIR/default-float.lua"

mkdir -p "$TOGGLE_DIR"

if [[ -f "$TOGGLE_FILE" ]]; then
  rm -f "$TOGGLE_FILE"
  hyprctl reload config-only >/dev/null 2>&1
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󰖲 "Modo flotante desactivado (Tiling por defecto)"
  fi
else
  cat <<'EOF' > "$TOGGLE_FILE"
-- Generated by omarchy-hyprland-floating-mode-toggle
o.window(".*", { float = true })
-- Override explicit tile=true rules from Omarchy default app configurations (e.g. Chromium-based browsers)
o.window({ tag = "chromium-based-browser" }, { float = true, size = "1088 648" })
o.window({ class = "codium" }, { float = true, size = "1088 648" })
o.window({ class = "com.microsoft.VSCode" }, { float = true, size = "1088 648" })
o.window({ class = "org.gnome.Papers" }, { float = true, size = "1023 578" })
o.window({ class = "notion" }, { float = true, size = "1263 660" })
EOF
  hyprctl reload config-only >/dev/null 2>&1
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󰖲 "Modo flotante activado (Float por defecto)"
  fi
fi
