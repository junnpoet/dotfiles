{
  "mcpServers": {
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "markitdown": {
      "args": [
        "markitdown-mcp"
      ],
      "command": "uvx",
      "disabled": false
    },
    "playwright": {
      "args": [
        "mcp",
        "--browser",
        "chromium"
      ],
      "command": "playwright"
    }
  }
}
